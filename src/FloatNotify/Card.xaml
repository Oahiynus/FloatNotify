<Window x:Class="FloatNotify.Card" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="浮笺提醒" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" WindowStartupLocation="Manual"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Foreground="#182530" Language="zh-CN"
 TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <LinearGradientBrush x:Key="LiquidFace" StartPoint="0,0" EndPoint=".6,1"><GradientStop Color="#68F7FAFD"/><GradientStop Color="#60F1F6FA" Offset=".48"/><GradientStop Color="#60F5F9FC" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="AdaptiveFace" Color="#C8252D38"/>
  <LinearGradientBrush x:Key="FrostedFace" StartPoint="0,0" EndPoint=".6,1"><GradientStop Color="#C7F8FAFC"/><GradientStop Color="#B4EDF2F7" Offset=".58"/><GradientStop Color="#C2F5F8FA" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Rim" StartPoint=".12,0" EndPoint=".86,1"><GradientStop Color="#F9FFFFFF"/><GradientStop Color="#90FFFFFF" Offset=".19"/><GradientStop Color="#6A718695" Offset=".53"/><GradientStop Color="#EEFFFFFF" Offset=".89"/><GradientStop Color="#A9FFFFFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Lens" StartPoint="0,0" EndPoint=".7,1"><GradientStop Color="#43FFFFFF"/><GradientStop Color="#1CFFFFFF" Offset=".55"/><GradientStop Color="#37E8F2F8" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="LensEdge" StartPoint="0,0" EndPoint=".3,1"><GradientStop Color="#B3FFFFFF"/><GradientStop Color="#65F4FAFF" Offset=".5"/><GradientStop Color="#556E8294" Offset="1"/></LinearGradientBrush>
  <Geometry x:Key="ExternalIcon">M 7,4 H 4 Q 2.5,4 2.5,5.5 V 12 Q 2.5,13.5 4,13.5 H 10.5 Q 12,13.5 12,12 V 9 M 7,8.5 L 13.3,2.2 M 9.1,2.2 H 13.3 V 6.4</Geometry>
  <Style x:Key="External" TargetType="Path"><Setter Property="Data" Value="{StaticResource ExternalIcon}"/><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/><Setter Property="Margin" Value="5,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Stroke" Value="#273743"/><Setter Property="StrokeThickness" Value="1.3"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="54"/><Setter Property="Padding" Value="8,0"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="#1B282E"/>
   <Setter Property="Background" Value="{StaticResource Lens}"/><Setter Property="BorderBrush" Value="{StaticResource LensEdge}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid><Border x:Name="Shell" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
     <Border x:Name="Tint" CornerRadius="14" IsHitTestVisible="False"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Background" Value="#32FFFFFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Background" Value="#284F6878"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#6B7E89"/><Setter TargetName="Shell" Property="BorderThickness" Value="1.5"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".58"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SplitPart" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="MinWidth" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <!-- Answer selection is shared by live and trial cards; its colors match the settings preview. -->
  <LinearGradientBrush x:Key="SelectedAnswerGlass" StartPoint="0,0.15" EndPoint="1,0.85">
   <GradientStop Color="#DBF6FAFF"/><GradientStop Color="#ABDAEBFF" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="Option" TargetType="RadioButton">
   <Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Row" CornerRadius="12" Background="{StaticResource Lens}" BorderThickness="1" BorderBrush="{StaticResource LensEdge}" Padding="11,7">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Top" Margin="0,3,0,0"><Grid Width="14" Height="14"><Ellipse x:Name="Circle" Fill="#63FFFFFF" Stroke="#71838D"/><Ellipse x:Name="Dot" Width="8" Height="8" Fill="Transparent"/></Grid></StackPanel>
      <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
     </Grid>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#53FFFFFF"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Row" Property="BorderBrush" Value="#6892CF"/>
      <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedAnswerGlass}"/>
      <Setter Property="Foreground" Value="#12385E"/>
      <Setter TargetName="Circle" Property="Stroke" Value="#205FB5"/>
      <Setter TargetName="Circle" Property="Fill" Value="White"/>
      <Setter TargetName="Dot" Property="Fill" Value="#205FB5"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#4780C1"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="18">
  <Border x:Name="GlassShell" CornerRadius="30" Background="{StaticResource LiquidFace}" BorderBrush="{StaticResource Rim}" BorderThickness="1.3" IsHitTestVisible="False">
   <Border.Effect><DropShadowEffect BlurRadius="13" ShadowDepth="3" Opacity=".2" Color="#263846"/></Border.Effect>
   <Border Margin="1" CornerRadius="28" BorderThickness="1" BorderBrush="#48FFFFFF"/>
  </Border>
  <Border x:Name="DialogFace" Background="Transparent" CornerRadius="30" Padding="24,19,24,16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Path DockPanel.Dock="Left" x:Name="BadgeIcon" Width="14" Height="14" Stretch="Uniform" Stroke="#44545F" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock DockPanel.Dock="Left" x:Name="KindLabel" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#34434C" VerticalAlignment="Center"/><TextBlock x:Name="ChatLabel" Margin="12,0,0,0" FontSize="12" Foreground="#516576" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
     <StackPanel>
      <TextBlock x:Name="Headline" Focusable="True" KeyboardNavigation.IsTabStop="False" AutomationProperties.HeadingLevel="Level1" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock x:Name="Purpose" Visibility="Collapsed" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
      <Border x:Name="ContextBox" CornerRadius="10" Background="#80F0F5FA" BorderBrush="{StaticResource LensEdge}" BorderThickness="1" Padding="10,6" Visibility="Collapsed">
       <StackPanel><DockPanel LastChildFill="True"><Button x:Name="CodeFold" DockPanel.Dock="Right" Style="{StaticResource Action}" MinWidth="0" Height="22" FontSize="12" Visibility="Collapsed" Content="展开代码"/>
        <TextBlock x:Name="CodeLabel" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#405361"/></DockPanel>
        <TextBlock x:Name="ContextText" Margin="0,3,0,0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="#263A4A"/>
       </StackPanel></Border>
      <TextBlock x:Name="LocationText" Visibility="Collapsed" Margin="0,5,0,0" FontSize="12" Foreground="#40515D" TextWrapping="Wrap"/>
      <StackPanel x:Name="Options"/>
      <Grid x:Name="EditorBox" Visibility="Collapsed">
       <Border x:Name="EditorFrame" Background="{StaticResource Lens}" BorderBrush="{StaticResource LensEdge}" BorderThickness="1" CornerRadius="12"/>
       <TextBox x:Name="Editor" FontSize="14" Background="Transparent" Foreground="#172736" BorderThickness="0" FocusVisualStyle="{x:Null}" Padding="12,8" MinHeight="56" MaxHeight="138" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextBlock.LineHeight="20">
        <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/></ControlTemplate></TextBox.Template>
       </TextBox><TextBlock x:Name="Placeholder" Margin="12,8" VerticalAlignment="Top" Foreground="#445662" FontSize="14" IsHitTestVisible="False"/>
      </Grid>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2">
     <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="0,6,0,0" FontSize="12" Foreground="#354956" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <Border x:Name="MenuBox" Visibility="Collapsed" HorizontalAlignment="Right" BorderBrush="{StaticResource LensEdge}" BorderThickness="1" CornerRadius="12" Background="#F2EDF3F7" Padding="4" Margin="0,5,0,0"><ScrollViewer MaxHeight="128" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MenuItems"/></ScrollViewer></Border>
    </StackPanel>
    <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="Ignore" Style="{StaticResource Action}" Content="忽略" ToolTip="收起提醒，稍后在原对话处理"/>
      <Button x:Name="Open" Margin="6,0,0,0" Style="{StaticResource Action}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="OpenLabel"/><Path Style="{StaticResource External}"/></StackPanel></Button></StackPanel>
     <Button x:Name="Send" DockPanel.Dock="Right" Style="{StaticResource Action}" AutomationProperties.Name="{Binding Text, ElementName=SendLabel}" Visibility="Collapsed"><TextBlock x:Name="SendLabel" Text="发送"/></Button>
     <WrapPanel x:Name="ApprovalStrip" DockPanel.Dock="Right" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center">
      <WrapPanel x:Name="Decisions" VerticalAlignment="Center"/>
      <Border x:Name="ApprovalGroup" Background="{StaticResource Lens}" BorderBrush="{StaticResource LensEdge}" BorderThickness="1" CornerRadius="14" Margin="5,0,0,0" Height="32">
       <StackPanel Orientation="Horizontal"><WrapPanel x:Name="AllowActions"/><Border x:Name="MenuDivider" Background="#506D808C" Width="1" Margin="0,6" Visibility="Collapsed"/><WrapPanel x:Name="MoreActions"/></StackPanel>
      </Border>
     </WrapPanel>
    </DockPanel>
   </Grid>
  </Border>
  <Border x:Name="Hud" Background="Transparent" CornerRadius="29" Padding="15,9" MinHeight="60" Visibility="Collapsed">
   <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
    <Border Width="24" Height="24" CornerRadius="12" Background="#B5D8E8E0"><Path Width="12" Height="9" Stretch="Uniform" Stroke="#315F50" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 2,7 L 6,11 L 15,2"/></Border>
    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"><TextBlock x:Name="DoneLabel" FontSize="12" Foreground="#324553"/><TextBlock x:Name="DoneText" FontSize="16" FontWeight="SemiBold" MaxHeight="42" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></StackPanel>
    <Button x:Name="HudOpen" Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource Action}" Focusable="False"><StackPanel Orientation="Horizontal"><TextBlock x:Name="HudOpenLabel"/><Path Style="{StaticResource External}"/></StackPanel></Button>
    <Button x:Name="HudClose" Grid.Column="3" MinWidth="32" Width="32" Padding="0" Style="{StaticResource Action}" Focusable="False" AutomationProperties.Name="关闭提醒" ToolTip="关闭提醒"><Path Width="12" Height="12" Stroke="#30404B" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L10,10 M2,10 L10,2"/></Button>
   </Grid>
  </Border>
 </Grid>
</Window>
